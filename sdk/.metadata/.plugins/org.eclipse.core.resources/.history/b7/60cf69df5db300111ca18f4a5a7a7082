#include <stdio.h>
#include "hbird_sdk_soc.h"

#define LED_PIN     (0)  // gpioA_0

void delay_ms(uint32_t ms)
{
    uint32_t i,j;
    for(i=0; i<ms; i++)
        for(j=0;j<12000;j++);
}

int main(void)
{
    int i = 0;
    GPIOA->DIR |= (1 << LED_PIN); // 设置gpioA_0为输出模式

    while(1)
    {
        printf("%d: Hello Zynq7010, LED0 toggle\r\n",i);
        i++;
        GPIOA->OUT ^= (1 << LED_PIN); // 翻转电平
        delay_ms(500);
    }
    return 0;
}
