/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include <stdint.h>

#include "D:/fpgafile/e203_cnn/sdk/LeNet_5/weight/lenet_weights.h"
#include "D:/fpgafile/e203_cnn/sdk/LeNet_5/weight/mnist_samples.h"

// ============ 网络配置 ============
#define INPUT_H       28
#define INPUT_W       28

#define C1_OUT_CH     6
#define C1_KERNEL     5
#define C1_OUT_H      (INPUT_H - C1_KERNEL + 1)   // 24
#define C1_OUT_W      (INPUT_W - C1_KERNEL + 1)   // 24

#define S2_OUT_H      (C1_OUT_H / 2)              // 12
#define S2_OUT_W      (C1_OUT_W / 2)              // 12

#define C3_OUT_CH     16
#define C3_KERNEL     5
#define C3_OUT_H      (S2_OUT_H - C3_KERNEL + 1)  // 8
#define C3_OUT_W      (S2_OUT_W - C3_KERNEL + 1)  // 8

#define S4_OUT_CH     C3_OUT_CH                   // 16
#define S4_OUT_H      (C3_OUT_H / 2)              // 4
#define S4_OUT_W      (C3_OUT_W / 2)              // 4

#define C5_OUT        120
#define C5_IN         (S4_OUT_CH * S4_OUT_H * S4_OUT_W)  // 256

#define F6_OUT        84
#define OUT_NUM       10

#define QUANT_SHIFT   8

// 想测哪个数字就改这里（0-9）
#define TEST_DIGIT    6

// ============ 中间张量（只保留可写的） ============
static int8_t  input_img[INPUT_H][INPUT_W];
static int8_t  c1_out[C1_OUT_CH][C1_OUT_H][C1_OUT_W];
static int8_t  s2_out[C1_OUT_CH][S2_OUT_H][S2_OUT_W];
static int8_t  c3_out[C3_OUT_CH][C3_OUT_H][C3_OUT_W];
static int8_t  s4_out[S4_OUT_CH][S4_OUT_H][S4_OUT_W];
static int8_t  c5_out[C5_OUT];
static int8_t  f6_out[F6_OUT];
static int32_t final_out[OUT_NUM];

// ============ 计时 ============

// ============ 量化辅助 ============
static inline int8_t quant_i8(int32_t acc) {
    int32_t r = acc >> QUANT_SHIFT;
    if (r > 127)  return  127;
    if (r < -128) return -128;
    return (int8_t)r;
}

// ============ MNIST 样本查找表 ============
static const unsigned char (* const mnist_table[10])[28] = {
    digit0_mnist, digit1_mnist, digit2_mnist, digit3_mnist, digit4_mnist,
    digit5_mnist, digit6_mnist, digit7_mnist, digit8_mnist, digit9_mnist,
};

// ============ 输入初始化 ============
static void init_input(void) {
    const unsigned char (*src)[28] = mnist_table[TEST_DIGIT];
    for (int i = 0; i < INPUT_H; i++)
        for (int j = 0; j < INPUT_W; j++)
            input_img[i][j] = (int8_t)(src[i][j] * 100 / 255);
}

// ============ C1 卷积 + ReLU ============
// c1_weight 布局：[C1_OUT_CH][C1_KERNEL][C1_KERNEL] = 6*5*5 = 150
static void conv_c1(void) {
    for (int oc = 0; oc < C1_OUT_CH; oc++) {
        for (int oh = 0; oh < C1_OUT_H; oh++) {
            for (int ow = 0; ow < C1_OUT_W; ow++) {
                int32_t sum = c1_bias[oc];
                for (int kh = 0; kh < C1_KERNEL; kh++)
                    for (int kw = 0; kw < C1_KERNEL; kw++)
                        sum += (int32_t)input_img[oh + kh][ow + kw]
                             * (int32_t)c1_weight[oc*25 + kh*5 + kw];
                int8_t v = quant_i8(sum);
                c1_out[oc][oh][ow] = (v < 0) ? 0 : v;
            }
        }
    }
}

// ============ S2 平均池化 ============
static void pool_s2(void) {
    for (int ch = 0; ch < C1_OUT_CH; ch++)
        for (int oh = 0; oh < S2_OUT_H; oh++)
            for (int ow = 0; ow < S2_OUT_W; ow++) {
                int32_t sum = 0;
                for (int m = 0; m < 2; m++)
                    for (int n = 0; n < 2; n++)
                        sum += c1_out[ch][oh * 2 + m][ow * 2 + n];
                s2_out[ch][oh][ow] = (int8_t)(sum >> 2);
            }
}

// ============ C3 卷积 + ReLU ============
// c3_weight 布局：[C3_OUT_CH][C1_OUT_CH][C3_KERNEL][C3_KERNEL]
//               = 16*6*5*5 = 2400
// 线性索引：((oc*6 + ic)*5 + kh)*5 + kw
static void conv_c3(void) {
    for (int oc = 0; oc < C3_OUT_CH; oc++) {
        for (int oh = 0; oh < C3_OUT_H; oh++) {
            for (int ow = 0; ow < C3_OUT_W; ow++) {
                int32_t sum = c3_bias[oc];
                for (int ic = 0; ic < C1_OUT_CH; ic++)
                    for (int kh = 0; kh < C3_KERNEL; kh++)
                        for (int kw = 0; kw < C3_KERNEL; kw++)
                            sum += (int32_t)s2_out[ic][oh + kh][ow + kw]
                                 * (int32_t)c3_weight[(oc*6 + ic)*25 + kh*5 + kw];
                int8_t v = quant_i8(sum);
                c3_out[oc][oh][ow] = (v < 0) ? 0 : v;
            }
        }
    }
}

// ============ S4 平均池化 ============
static void pool_s4(void) {
    for (int ch = 0; ch < S4_OUT_CH; ch++)
        for (int oh = 0; oh < S4_OUT_H; oh++)
            for (int ow = 0; ow < S4_OUT_W; ow++) {
                int32_t sum = 0;
                for (int m = 0; m < 2; m++)
                    for (int n = 0; n < 2; n++)
                        sum += c3_out[ch][oh * 2 + m][ow * 2 + n];
                s4_out[ch][oh][ow] = (int8_t)(sum >> 2);
            }
}

// ============ C5 全连接 + ReLU ============
// c5_weight 布局：[C5_OUT][C5_IN] = 120*256 = 30720
// 线性索引：i*256 + j
static void fc_c5(void) {
    const int8_t *flat = &s4_out[0][0][0];
    for (int i = 0; i < C5_OUT; i++) {
        int32_t sum = c5_bias[i];
        for (int j = 0; j < C5_IN; j++)
            sum += (int32_t)flat[j] * (int32_t)c5_weight[i*256 + j];
        int8_t v = quant_i8(sum);
        c5_out[i] = (v < 0) ? 0 : v;
    }
}

// ============ F6 全连接 + ReLU ============
// f6_weight 布局：[F6_OUT][C5_OUT] = 84*120 = 10080
// 线性索引：i*120 + j
static void fc_f6(void) {
    for (int i = 0; i < F6_OUT; i++) {
        int32_t sum = f6_bias[i];
        for (int j = 0; j < C5_OUT; j++)
            sum += (int32_t)c5_out[j] * (int32_t)f6_weight[i*120 + j];
        int8_t v = quant_i8(sum);
        f6_out[i] = (v < 0) ? 0 : v;
    }
}

// ============ 输出层（无 ReLU） ============
// out_weight 布局：[OUT_NUM][F6_OUT] = 10*84 = 840
// 线性索引：i*84 + j
static void fc_out(void) {
    for (int i = 0; i < OUT_NUM; i++) {
        int32_t sum = out_bias[i];
        for (int j = 0; j < F6_OUT; j++)
            sum += (int32_t)f6_out[j] * (int32_t)out_weight[i*84 + j];
        final_out[i] = sum;
    }
}

// ============ Argmax ============
static int argmax(const int32_t *arr, int n) {
    int best = 0;
    for (int i = 1; i < n; i++)
        if (arr[i] > arr[best]) best = i;
    return best;
}

// ============ 主函数 ============
int main(void) {
    printf("\n===== LeNet-5 INT8 Software Benchmark =====\n");
    printf("Core: RV32I (E203)\n");
    printf("Quant shift: %d\n", QUANT_SHIFT);
    printf("Test image: MNIST real digit %d\n", TEST_DIGIT);

    printf("Initializing test data...\n");
    init_input();
    printf("Init done.\n");

//    uint32_t t_start = get_cycle();
    uint32_t t_start, t_end;

    XTime_GetTime(&t_start);
    conv_c1();
    pool_s2();
    conv_c3();
    pool_s4();
    fc_c5();
    fc_f6();
    fc_out();
    XTime_GetTime(&t_end);
//    uint32_t t_end = get_cycle();
    uint32_t cycles = t_end - t_start;

    int pred = argmax(final_out, OUT_NUM);

    printf("Predicted class: %d\n", pred);
    printf("Final output scores:\n");
    for (int i = 0; i < OUT_NUM; i++)
        printf("  class[%d] = %d\n", i, (int)final_out[i]);

    printf("\n===== Benchmark Result =====\n");
    printf("Total cycles: %u\n", cycles);
    uint32_t SystemCoreClock = (uint32_t)XPAR_CPU_CORE_CLOCK_FREQ_HZ
    printf("CPU Frequency: %u Hz\n", SystemCoreClock);

    if (SystemCoreClock > 0) {
        uint32_t ms = (uint32_t)((uint64_t)cycles * 1000ULL / SystemCoreClock);
        printf("Total time: %u ms\n", ms);
    }

    printf("===== Benchmark Done =====\n\n");

    while (1);
    return 0;
}
